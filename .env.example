# Copy to .env and fill in. .env is gitignored.
# Free key from https://finnhub.io/register
FINNHUB_KEY=

# Host port the API is published on.
PRICER_PORT=8080

# Trading days used for the historical volatility estimate.
PRICER_VOL_WINDOW=60

# Provider calls allowed per minute. Finnhub's free tier permits 60.
PRICER_RATE_LIMIT=55

# Cache lifetimes in seconds.
PRICER_QUOTE_TTL=60
PRICER_CHAIN_TTL=900
